/* ------------------------------------------------------------------------ */
/* JMComic-qt Modern Theme (dark_orange)                                         */
/* Generated by script/build_theme.py                                       */
/* ------------------------------------------------------------------------ */

* {
  color: #E8ECF2;
  font-family: "Microsoft YaHei UI", "PingFang SC", "Segoe UI", sans-serif;
  /*replace*/
  selection-background-color: rgba(255, 138, 31, 0.35);
  selection-color: #FFFFFF;
}

*:focus {
  outline: none;
}

/* ------------------------------------------------------------------------ */
/* Semantic helper classes & roles                                          */

.danger,
QLabel[role="danger"] {
  color: #EF4444;
}

.warning,
QLabel[role="warning"] {
  color: #F59E0B;
}

.success,
QLabel[role="success"] {
  color: #10B981;
}

QLabel[role="muted"] {
  color: #94A3B8;
}

QLabel[role="sectionTitle"] {
  color: #FF8A1F;
  font-weight: 600;
}

QLabel[role="pageTitle"] {
  color: #E8ECF2;
  font-size: 18px;
  font-weight: 700;
}

QLabel[role="cardTitle"] {
  color: #E8ECF2;
  font-weight: 600;
}

QLabel[role="breadcrumbSep"] {
  color: #94A3B8;
  padding: 0 2px;
}

QFrame[role="card"],
QWidget[role="card"] {
  background-color: #22252D;
  border: 1px solid #2E333E;
  border-radius: 10px;
}

/* Modal dialog card */
QWidget#centerWidget {
  background-color: #22252D;
  border: 1px solid #3D4452;
  border-radius: 12px;
}

/* Top breadcrumb header bar */
QWidget#headerBar {
  background-color: #181A1F;
  border-bottom: 1px solid #2A2F3A;
}

QWidget#headerBar QToolButton {
  height: 28px;
  padding: 2px 10px;
  border-radius: 6px;
  color: #94A3B8;
  font-weight: 500;
}

QWidget#headerBar QToolButton:hover {
  color: #E8ECF2;
  background-color: #2F3440;
}

QWidget#headerBar QToolButton:checked {
  color: #E8ECF2;
  background-color: transparent;
  font-weight: 600;
}

/* Setting & Login cards */
SettingView QScrollArea .QFrame,
LoginNewView QWidget#tab_4 .QFrame {
  background-color: #22252D;
  border: 1px solid #2E333E;
  border-radius: 10px;
}

LoginNewView QWidget#widget {
  background-color: #22252D;
  border: 1px solid #2E333E;
  border-radius: 12px;
}

/* ------------------------------------------------------------------------ */
/* Base containers                                                          */

QWidget {
  /*replace*/
  background-color: #181A1F;
}

QWidget#MainWindows {
  border: 1px solid #2E333E;
  border-radius: 10px;
}

QFrame {
  background-color: #181A1F;
  border: 1px solid #2E333E;
  border-radius: 6px;
}

QSplitter {
  background-color: transparent;
  border: none;
}

QSplitter::handle {
  background-color: transparent;
}

QStatusBar {
  color: #94A3B8;
  background-color: #22252D;
  border-top: 1px solid #2A2F3A;
  border-radius: 0px;
}

QScrollArea,
QStackedWidget,
QWidget > QToolBox,
QToolBox > QWidget,
QTabWidget > QWidget {
  border: none;
}

QTabWidget::pane {
  border: none;
  background-color: transparent;
}

QListWidget,
QScrollArea {
  background-color: transparent;
  border: none;
}

QToolTip {
  color: #E8ECF2;
  background-color: #272B35;
  border: 1px solid #3D4452;
  border-radius: 6px;
  padding: 6px 10px;
}

/* ------------------------------------------------------------------------ */
/* Sidebar Navigation                                                       */

NavigationWidget,
NavigationWidget > QWidget,
NavigationWidget QWidget#topWidget,
NavigationWidget QScrollArea,
NavigationWidget QScrollArea > QWidget,
NavigationWidget QWidget#scrollAreaWidgetContents {
  background-color: #1E2128;
}

NavigationWidget {
  border-right: 1px solid #2A2F3A;
}

NavigationWidget QLabel#label,
NavigationWidget QLabel#label_2,
NavigationWidget QLabel#label_3 {
  color: #94A3B8;
  font-weight: 600;
  padding: 8px 12px 2px 12px;
}

NavigationWidget QLabel#label_4,
NavigationWidget QLabel#label_5,
NavigationWidget QLabel#label_6,
NavigationWidget QLabel#label_7,
NavigationWidget QLabel#label_8,
NavigationWidget QLabel#label_9,
NavigationWidget QLabel#expLabel {
  color: #94A3B8;
}

NavigationWidget QLabel#nameLabel {
  color: #E8ECF2;
  font-size: 13px;
  font-weight: 600;
}

NavigationWidget QLabel#titleLabel {
  color: #FF8A1F;
  font-size: 11px;
}

NavigationWidget QToolButton {
  height: 36px;
  margin: 2px 8px;
  padding: 4px 12px;
  border-radius: 8px;
  text-align: left;
}

NavigationWidget QToolButton:hover {
  background-color: #282C36;
}

NavigationWidget QToolButton:checked {
  background-color: rgba(255, 138, 31, 0.16);
  color: #FF8A1F;
  font-weight: 600;
  border-left: 3px solid #FF8A1F;
  border-top-left-radius: 2px;
  border-bottom-left-radius: 2px;
  border-top-right-radius: 8px;
  border-bottom-right-radius: 8px;
  padding-left: 9px;
}

NavigationWidget QToolButton:checked:hover {
  background-color: rgba(255, 138, 31, 0.24);
}

NavigationWidget[collapsed="true"] QToolButton {
  height: 40px;
  margin: 2px 6px;
  padding: 0px;
  border-radius: 8px;
}

NavigationWidget[collapsed="true"] QToolButton:checked {
  border-left: 3px solid #FF8A1F;
  border-top-left-radius: 2px;
  border-bottom-left-radius: 2px;
  border-top-right-radius: 8px;
  border-bottom-right-radius: 8px;
  padding-left: 0px;
}

NavigationWidget[collapsed="true"] QFrame[frameShape="4"] {
  margin: 4px 12px;
}

NavigationWidget[collapsed="true"] QScrollBar:vertical {
  width: 4px;
}

NavigationWidget QPushButton#hideButton {
  height: 26px;
  min-height: 26px;
  max-height: 28px;
  padding: 0px 10px;
  font-size: 12px;
  font-weight: 500;
}

/* ------------------------------------------------------------------------ */
/* Comic Card & Comment Item                                                */

QWidget#ComicItem {
  background-color: transparent;
  border: 1px solid transparent;
  border-radius: 10px;
}

QWidget#ComicItem:hover {
  background-color: #22252D;
  border: 1px solid #3D4452;
}

QWidget#ComicItem QLabel#categoryLabel,
QWidget#ComicItem QLabel#timeLabel,
QWidget#ComicItem QToolButton#starButton {
  color: #94A3B8;
  font-size: 12px;
}

QWidget#ComicItem QLabel#nameLable {
  color: #E8ECF2;
}

QWidget#CommentItem QLabel#indexLabel,
QWidget#CommentItem QLabel#dateLabel {
  color: #94A3B8;
}

QWidget#CommentItem QLabel#nameLabel {
  color: #E8ECF2;
  font-weight: 600;
}

QWidget#CommentItem QLabel#levelLabel,
QWidget#CommentItem QLabel#titleLabel {
  color: #FF8A1F;
  font-weight: 600;
}

/* Book Detail Page */
BookInfoView QLabel#title {
  color: #E8ECF2;
  font-size: 18px;
  font-weight: 700;
}

BookInfoView QLabel#picture {
  background-color: transparent;
  border: none;
  padding: 6px;
}

BookInfoView QLabel#picture[empty="true"] {
  background-color: #22252D;
  border: 1px solid #2E333E;
  border-radius: 10px;
  color: #94A3B8;
}

BookInfoView QPlainTextEdit#description {
  background-color: #22252D;
  border: 1px solid #2E333E;
  border-radius: 8px;
  padding: 8px 10px;
  color: #E8ECF2;
}

BookInfoView QLabel#label_6,
BookInfoView QLabel#label_4,
BookInfoView QLabel#label_8,
BookInfoView QLabel#label_13,
BookInfoView QLabel#label_2,
BookInfoView QLabel#label_3,
BookInfoView QLabel#label_5 {
  color: #94A3B8;
}

/* ------------------------------------------------------------------------ */
/* Inputs                                                                   */

QDateTimeEdit,
QSpinBox,
QDoubleSpinBox,
QTextEdit,
QPlainTextEdit,
QLineEdit,
QComboBox {
  color: #E8ECF2;
  background-color: #272B35;
  border: 1px solid #2E333E;
  border-radius: 6px;
  padding: 6px 12px;
  min-height: 20px;
}

QDateTimeEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QTextEdit:hover,
QPlainTextEdit:hover,
QLineEdit:hover,
QComboBox:hover {
  border-color: #3D4452;
}

QDateTimeEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QLineEdit:focus,
QComboBox:focus,
QComboBox:on {
  border: 1px solid #FF8A1F;
  background-color: #272B35;
}

QDateTimeEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled,
QLineEdit:disabled,
QComboBox:disabled {
  color: rgba(232, 236, 242, 0.35);
  background-color: #1D2026;
  border-color: #2E333E;
}

QTextEdit,
QPlainTextEdit {
  padding: 8px 10px;
}

/* ------------------------------------------------------------------------ */
/* QComboBox                                                                */

QComboBox {
  padding-right: 28px;
  min-height: 22px;
}

QComboBox::drop-down {
  subcontrol-origin: padding;
  subcontrol-position: top right;
  width: 24px;
  border: none;
  background-color: transparent;
}

QComboBox::down-arrow {
  image: url(:/icon/theme/dark_orange/primary/downarrow.svg);
  width: 12px;
  height: 12px;
  margin-right: 6px;
}

QComboBox::down-arrow:disabled {
  image: url(:/icon/theme/dark_orange/disabled/downarrow.svg);
}

QComboBox QAbstractItemView {
  background-color: #272B35;
  color: #E8ECF2;
  border: 1px solid #3D4452;
  border-radius: 8px;
  padding: 4px;
  outline: none;
  selection-background-color: rgba(255, 138, 31, 0.16);
  selection-color: #FF8A1F;
}

QComboBox[frame='false'] {
  color: #E8ECF2;
  background-color: transparent;
  border: 1px solid transparent;
}

QComboBox[frame='false']:disabled {
  color: rgba(232, 236, 242, 0.35);
}

/* ------------------------------------------------------------------------ */
/* SpinBox arrows                                                           */

QDateTimeEdit::up-button,
QDoubleSpinBox::up-button,
QSpinBox::up-button {
  subcontrol-origin: border;
  subcontrol-position: top right;
  width: 20px;
  image: url(:/icon/theme/dark_orange/primary/uparrow.svg);
  border-width: 0px;
  margin-right: 4px;
}

QDateTimeEdit::up-button:disabled,
QDoubleSpinBox::up-button:disabled,
QSpinBox::up-button:disabled {
  image: url(:/icon/theme/dark_orange/disabled/uparrow.svg);
}

QDateTimeEdit::down-button,
QDoubleSpinBox::down-button,
QSpinBox::down-button {
  subcontrol-origin: border;
  subcontrol-position: bottom right;
  width: 20px;
  image: url(:/icon/theme/dark_orange/primary/downarrow.svg);
  border-width: 0px;
  margin-right: 4px;
}

QDateTimeEdit::down-button:disabled,
QDoubleSpinBox::down-button:disabled,
QSpinBox::down-button:disabled {
  image: url(:/icon/theme/dark_orange/disabled/downarrow.svg);
}

/* ------------------------------------------------------------------------ */
/* QPushButton                                                              */

QPushButton {
  color: #E8ECF2;
  background-color: #272B35;
  border: 1px solid #3D4452;
  border-radius: 7px;
  margin: 0px;
  padding: 0px 14px;
  height: 32px;
  min-height: 32px;
  max-height: 34px;
  font-weight: 600;
}

QPushButton:hover {
  color: #FF8A1F;
  background-color: #2F3440;
  border-color: #FF8A1F;
}

QPushButton:checked,
QPushButton:pressed {
  color: #FFFFFF;
  background-color: #FF8A1F;
  border-color: #FF8A1F;
}

/* Primary accent buttons */
QPushButton[variant="primary"],
NavigationWidget QPushButton#pushButton,
CommentView QPushButton#pushButton,
AllCommentView QPushButton#pushButton,
SubCommentView QPushButton#pushButton,
MyCommentView QPushButton#pushButton,
DownloadView QPushButton#pushButton,
QPushButton#searchButton,
QPushButton#startRead,
QPushButton#readOffline,
QPushButton#loginButton,
QPushButton#downButton,
QPushButton#saveButton,
QPushButton#registerButton {
  color: #FFFFFF;
  background-color: #FF8A1F;
  border: 1px solid #FF8A1F;
}

QPushButton[variant="primary"]:hover,
NavigationWidget QPushButton#pushButton:hover,
CommentView QPushButton#pushButton:hover,
AllCommentView QPushButton#pushButton:hover,
SubCommentView QPushButton#pushButton:hover,
MyCommentView QPushButton#pushButton:hover,
DownloadView QPushButton#pushButton:hover,
QPushButton#searchButton:hover,
QPushButton#startRead:hover,
QPushButton#readOffline:hover,
QPushButton#loginButton:hover,
QPushButton#downButton:hover,
QPushButton#saveButton:hover,
QPushButton#registerButton:hover {
  color: #FFFFFF;
  background-color: #FF9E44;
  border-color: #FF9E44;
}

QPushButton[variant="primary"]:pressed,
NavigationWidget QPushButton#pushButton:pressed,
CommentView QPushButton#pushButton:pressed,
AllCommentView QPushButton#pushButton:pressed,
SubCommentView QPushButton#pushButton:pressed,
MyCommentView QPushButton#pushButton:pressed,
DownloadView QPushButton#pushButton:pressed,
QPushButton#searchButton:pressed,
QPushButton#startRead:pressed,
QPushButton#readOffline:pressed,
QPushButton#loginButton:pressed,
QPushButton#downButton:pressed,
QPushButton#saveButton:pressed,
QPushButton#registerButton:pressed {
  color: #FFFFFF;
  background-color: #E06D06;
  border-color: #E06D06;
}

/* QCommandLinkButton */
QCommandLinkButton {
  color: #E8ECF2;
  background-color: transparent;
  border: 1px solid transparent;
  border-radius: 8px;
  padding: 6px 12px;
  min-height: 32px;
  max-height: 40px;
  font-weight: 500;
  text-align: left;
}

QCommandLinkButton:hover {
  color: #FF8A1F;
  background-color: rgba(255, 138, 31, 0.16);
  border-color: transparent;
}

QCommandLinkButton:pressed,
QCommandLinkButton:checked {
  color: #FF8A1F;
  background-color: rgba(255, 138, 31, 0.24);
  border-color: transparent;
  font-weight: 600;
}

QPushButton:flat,
QPushButton#menuButton {
  padding: 4px 10px;
  margin: 0px;
  color: #E8ECF2;
  border: none;
  background-color: transparent;
}

QPushButton:flat:hover,
QPushButton#menuButton:hover {
  color: #FF8A1F;
  background-color: rgba(255, 138, 31, 0.16);
}

QPushButton:flat:pressed,
QPushButton:flat:checked,
QPushButton#menuButton:pressed {
  color: #FF8A1F;
  background-color: rgba(255, 138, 31, 0.24);
}

QPushButton:disabled,
QPushButton:flat:disabled {
  color: rgba(232, 236, 242, 0.35);
  background-color: transparent;
  border: 1px solid #2E333E;
}

QPushButton:flat:disabled {
  border: none;
}

QPushButton:checked:disabled {
  color: rgba(232, 236, 242, 0.35);
  background-color: #2F3440;
  border-color: #2E333E;
}

/* Semantic Buttons */
QPushButton.danger {
  border-color: #EF4444;
  color: #EF4444;
}

QPushButton.danger:hover {
  background-color: rgba(239, 68, 68, 0.16);
}

QPushButton.danger:checked,
QPushButton.danger:pressed {
  color: #FFFFFF;
  background-color: #EF4444;
}

QPushButton.warning {
  border-color: #F59E0B;
  color: #F59E0B;
}

QPushButton.warning:hover {
  background-color: rgba(245, 158, 11, 0.16);
}

QPushButton.warning:checked,
QPushButton.warning:pressed {
  color: #FFFFFF;
  background-color: #F59E0B;
}

QPushButton.success {
  border-color: #10B981;
  color: #10B981;
}

QPushButton.success:hover {
  background-color: rgba(16, 185, 129, 0.16);
}

QPushButton.success:checked,
QPushButton.success:pressed {
  color: #FFFFFF;
  background-color: #10B981;
}

/* ------------------------------------------------------------------------ */
/* QTabBar                                                                  */

QTabBar {
  font-weight: 600;
}

QTabBar::tab {
  color: #94A3B8;
  background-color: transparent;
  border: 0px;
}

QTabBar::tab:bottom,
QTabBar::tab:top {
  padding: 0 16px;
  height: 34px;
}

QTabBar::tab:left,
QTabBar::tab:right {
  padding: 14px 0;
  width: 32px;
}

QTabBar::tab:top:hover,
QTabBar::tab:bottom:hover,
QTabBar::tab:left:hover,
QTabBar::tab:right:hover {
  color: #E8ECF2;
}

QTabBar::tab:top:selected {
  color: #FF8A1F;
  border-bottom: 2px solid #FF8A1F;
}

QTabBar::tab:bottom:selected {
  color: #FF8A1F;
  border-top: 2px solid #FF8A1F;
}

QTabBar::tab:right:selected {
  color: #FF8A1F;
  border-left: 2px solid #FF8A1F;
}

QTabBar::tab:left:selected {
  color: #FF8A1F;
  border-right: 2px solid #FF8A1F;
}

QTabBar QToolButton,
QTabBar QToolButton:hover {
  border: none;
  background-color: #181A1F;
}

QTabBar QToolButton::up-arrow {
  image: url(:/icon/theme/dark_orange/disabled/uparrow2.svg);
}
QTabBar QToolButton::up-arrow:hover {
  image: url(:/icon/theme/dark_orange/primary/uparrow2.svg);
}
QTabBar QToolButton::down-arrow {
  image: url(:/icon/theme/dark_orange/disabled/downarrow2.svg);
}
QTabBar QToolButton::down-arrow:hover {
  image: url(:/icon/theme/dark_orange/primary/downarrow2.svg);
}
QTabBar QToolButton::right-arrow {
  image: url(:/icon/theme/dark_orange/disabled/rightarrow2.svg);
}
QTabBar QToolButton::right-arrow:hover {
  image: url(:/icon/theme/dark_orange/primary/rightarrow2.svg);
}
QTabBar QToolButton::left-arrow {
  image: url(:/icon/theme/dark_orange/disabled/leftarrow2.svg);
}
QTabBar QToolButton::left-arrow:hover {
  image: url(:/icon/theme/dark_orange/primary/leftarrow2.svg);
}
QTabBar::close-button {
  image: url(:/icon/theme/dark_orange/disabled/tab_close.svg);
}
QTabBar::close-button:hover {
  image: url(:/icon/theme/dark_orange/primary/tab_close.svg);
}

/* ------------------------------------------------------------------------ */
/* QGroupBox                                                                */

QGroupBox {
  background-color: #22252D;
  border: 1px solid #2E333E;
  border-radius: 8px;
  padding: 14px;
  padding-top: 28px;
  margin-top: 6px;
}

QGroupBox::title {
  color: #94A3B8;
  font-weight: 600;
  subcontrol-origin: margin;
  subcontrol-position: top left;
  padding: 0 12px;
  margin-top: 8px;
  background-color: transparent;
  height: 20px;
}

/* ------------------------------------------------------------------------ */
/* QRadioButton & QCheckBox                                                 */

QRadioButton,
QCheckBox {
  spacing: 8px;
  color: #E8ECF2;
  height: 28px;
  background-color: transparent;
}

QRadioButton:disabled,
QCheckBox:disabled {
  color: rgba(232, 236, 242, 0.35);
}

QGroupBox::indicator {
  width: 18px;
  height: 18px;
  border-radius: 4px;
}

QMenu::indicator,
QListView::indicator,
QTableWidget::indicator,
QRadioButton::indicator,
QCheckBox::indicator {
  width: 22px;
  height: 22px;
  border-radius: 4px;
}

QListView::indicator:checked,
QListView::indicator:checked:selected,
QListView::indicator:checked:focus {
  image: url(:/icon/theme/dark_orange/primary/checklist.svg);
}
QListView::indicator:checked:selected:active {
  image: url(:/icon/theme/dark_orange/primary/checklist_invert.svg);
}
QListView::indicator:checked:disabled {
  image: url(:/icon/theme/dark_orange/disabled/checklist.svg);
}
QListView::indicator:indeterminate,
QListView::indicator:indeterminate:selected,
QListView::indicator:indeterminate:focus {
  image: url(:/icon/theme/dark_orange/primary/checklist_indeterminate.svg);
}
QListView::indicator:indeterminate:selected:active {
  image: url(:/icon/theme/dark_orange/primary/checklist_indeterminate_invert.svg);
}
QListView::indicator:indeterminate:disabled {
  image: url(:/icon/theme/dark_orange/disabled/checklist_indeterminate.svg);
}

QTableView::indicator:enabled:checked,
QTableView::indicator:enabled:checked:selected,
QTableView::indicator:enabled:checked:focus {
  image: url(:/icon/theme/dark_orange/primary/checkbox_checked.svg);
}
QTableView::indicator:checked:selected:active {
  image: url(:/icon/theme/dark_orange/primary/checkbox_checked_invert.svg);
}
QTableView::indicator:disabled:checked,
QTableView::indicator:disabled:checked:selected,
QTableView::indicator:disabled:checked:focus {
  image: url(:/icon/theme/dark_orange/disabled/checkbox_checked.svg);
}
QTableView::indicator:enabled:unchecked,
QTableView::indicator:enabled:unchecked:selected,
QTableView::indicator:enabled:unchecked:focus {
  image: url(:/icon/theme/dark_orange/primary/checkbox_unchecked.svg);
}
QTableView::indicator:unchecked:selected:active {
  image: url(:/icon/theme/dark_orange/primary/checkbox_unchecked_invert.svg);
}
QTableView::indicator:disabled:unchecked,
QTableView::indicator:disabled:unchecked:selected,
QTableView::indicator:disabled:unchecked:focus {
  image: url(:/icon/theme/dark_orange/disabled/checkbox_unchecked.svg);
}
QTableView::indicator:enabled:indeterminate,
QTableView::indicator:enabled:indeterminate:selected,
QTableView::indicator:enabled:indeterminate:focus {
  image: url(:/icon/theme/dark_orange/primary/checkbox_indeterminate.svg);
}
QTableView::indicator:indeterminate:selected:active {
  image: url(:/icon/theme/dark_orange/primary/checkbox_indeterminate_invert.svg);
}
QTableView::indicator:disabled:indeterminate,
QTableView::indicator:disabled:indeterminate:selected,
QTableView::indicator:disabled:indeterminate:focus {
  image: url(:/icon/theme/dark_orange/disabled/checkbox_indeterminate.svg);
}

QCheckBox::indicator:checked,
QGroupBox::indicator:checked {
  image: url(:/icon/theme/dark_orange/primary/checkbox_checked.svg);
}
QCheckBox::indicator:unchecked,
QGroupBox::indicator:unchecked {
  image: url(:/icon/theme/dark_orange/primary/checkbox_unchecked.svg);
}
QCheckBox::indicator:indeterminate,
QGroupBox::indicator:indeterminate {
  image: url(:/icon/theme/dark_orange/primary/checkbox_indeterminate.svg);
}
QCheckBox::indicator:checked:disabled,
QGroupBox::indicator:checked:disabled {
  image: url(:/icon/theme/dark_orange/disabled/checkbox_checked.svg);
}
QCheckBox::indicator:unchecked:disabled,
QGroupBox::indicator:unchecked:disabled {
  image: url(:/icon/theme/dark_orange/disabled/checkbox_unchecked.svg);
}
QCheckBox::indicator:indeterminate:disabled,
QGroupBox::indicator:indeterminate:disabled {
  image: url(:/icon/theme/dark_orange/disabled/checkbox_indeterminate.svg);
}

QRadioButton::indicator:checked {
  image: url(:/icon/theme/dark_orange/primary/radiobutton_checked.svg);
}
QRadioButton::indicator:unchecked {
  image: url(:/icon/theme/dark_orange/primary/radiobutton_unchecked.svg);
}
QRadioButton::indicator:checked:disabled {
  image: url(:/icon/theme/dark_orange/disabled/radiobutton_checked.svg);
}
QRadioButton::indicator:unchecked:disabled {
  image: url(:/icon/theme/dark_orange/disabled/radiobutton_unchecked.svg);
}

/* ------------------------------------------------------------------------ */
/* QDockWidget                                                              */

QDockWidget {
  color: #E8ECF2;
  border: 1px solid #2E333E;
  titlebar-close-icon: url(:/icon/theme/dark_orange/primary/close.svg);
  titlebar-normal-icon: url(:/icon/theme/dark_orange/primary/float.svg);
  border-radius: 8px;
}

QDockWidget::title {
  text-align: left;
  padding-left: 16px;
  padding-top: 6px;
  padding-bottom: 6px;
}

/* ------------------------------------------------------------------------ */
/* Menus & ComboBox Items                                                   */

QComboBox::indicator:checked {
  image: url(:/icon/theme/dark_orange/primary/checklist.svg);
}
QComboBox::indicator:checked:selected {
  image: url(:/icon/theme/dark_orange/primary/checklist_invert.svg);
}

QComboBox::item,
QCalendarWidget QMenu::item,
QMenu::item {
  height: 28px;
  border: 4px solid transparent;
  color: #E8ECF2;
  border-radius: 6px;
}

QCalendarWidget QMenu::item,
QMenu::item {
  padding: 4px 20px 4px 14px;
}

QComboBox::item:selected,
QCalendarWidget QMenu::item:selected,
QMenu::item:selected {
  color: #FF8A1F;
  background-color: rgba(255, 138, 31, 0.16);
  border-radius: 6px;
}

QComboBox::item:disabled,
QCalendarWidget QMenu::item:disabled,
QMenu::item:disabled {
  color: rgba(232, 236, 242, 0.35);
}

QCalendarWidget QMenu,
QMenu {
  background-color: #272B35;
  border: 1px solid #3D4452;
  border-radius: 8px;
  padding: 4px;
}

QMenu::separator {
  height: 1px;
  background-color: #2A2F3A;
  margin: 4px 8px;
}

QMenu::right-arrow {
  image: url(:/icon/theme/dark_orange/primary/rightarrow.svg);
  width: 14px;
  height: 14px;
}
QMenu::right-arrow:selected {
  image: url(:/icon/theme/dark_orange/disabled/rightarrow.svg);
}
QMenu::indicator:non-exclusive:unchecked {
  image: url(:/icon/theme/dark_orange/primary/checkbox_unchecked.svg);
}
QMenu::indicator:non-exclusive:unchecked:selected {
  image: url(:/icon/theme/dark_orange/primary/checkbox_unchecked_invert.svg);
}
QMenu::indicator:non-exclusive:checked {
  image: url(:/icon/theme/dark_orange/primary/checkbox_checked.svg);
}
QMenu::indicator:non-exclusive:checked:selected {
  image: url(:/icon/theme/dark_orange/primary/checkbox_checked_invert.svg);
}
QMenu::indicator:exclusive:unchecked {
  image: url(:/icon/theme/dark_orange/primary/radiobutton_unchecked.svg);
}
QMenu::indicator:exclusive:unchecked:selected {
  image: url(:/icon/theme/dark_orange/primary/radiobutton_unchecked_invert.svg);
}
QMenu::indicator:exclusive:checked {
  image: url(:/icon/theme/dark_orange/primary/radiobutton_checked.svg);
}
QMenu::indicator:exclusive:checked:selected {
  image: url(:/icon/theme/dark_orange/primary/radiobutton_checked_invert.svg);
}

/* ------------------------------------------------------------------------ */
/* QMenuBar & QToolBox                                                      */

QMenuBar {
  background-color: #22252D;
  color: #E8ECF2;
  border-bottom: 1px solid #2A2F3A;
}

QMenuBar::item {
  height: 30px;
  padding: 6px 10px;
  background-color: transparent;
  color: #E8ECF2;
  border-radius: 6px;
}

QMenuBar::item:selected,
QMenuBar::item:pressed {
  color: #FF8A1F;
  background-color: rgba(255, 138, 31, 0.16);
}

QToolBox::tab {
  background-color: #22252D;
  color: #E8ECF2;
  border-radius: 6px;
  padding-left: 10px;
}

QToolBox::tab:selected,
QToolBox::tab:hover {
  color: #FF8A1F;
  background-color: rgba(255, 138, 31, 0.16);
}

/* ------------------------------------------------------------------------ */
/* QProgressBar                                                             */

QProgressBar {
  border: none;
  border-radius: 4px;
  background-color: #2A2F3A;
  text-align: center;
  color: transparent;
  min-height: 8px;
}

QProgressBar::chunk {
  background-color: #FF8A1F;
  border-radius: 4px;
}

/* ------------------------------------------------------------------------ */
/* Modern Capsule QScrollBar                                                */

QScrollBar:vertical {
  border: none;
  background: transparent;
  width: 8px;
  margin: 2px 0px 2px 0px;
}

QScrollBar:horizontal {
  border: none;
  background: transparent;
  height: 8px;
  margin: 0px 2px 0px 2px;
}

QScrollBar::handle:vertical {
  background: rgba(148, 163, 184, 0.32);
  min-height: 32px;
  border-radius: 4px;
}

QScrollBar::handle:horizontal {
  background: rgba(148, 163, 184, 0.32);
  min-width: 32px;
  border-radius: 4px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
  background: rgba(255, 138, 31, 0.78);
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical,
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
  background: none;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
  height: 0px;
  width: 0px;
  background: none;
  border: none;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
  height: 0px;
  width: 0px;
  background: none;
  border: none;
}

QScrollBar::up-arrow:vertical,
QScrollBar::down-arrow:vertical,
QScrollBar::left-arrow:horizontal,
QScrollBar::right-arrow:horizontal {
  width: 0px;
  height: 0px;
  background: none;
}

/* ------------------------------------------------------------------------ */
/* QSlider                                                                  */

QSlider:horizontal {
  min-height: 22px;
  max-height: 22px;
}

QSlider:vertical {
  min-width: 22px;
  max-width: 22px;
}

QSlider::groove:horizontal {
  height: 4px;
  background: #2E333E;
  border-radius: 2px;
  margin: 0 8px;
}

QSlider::groove:vertical {
  width: 4px;
  background: #2E333E;
  border-radius: 2px;
  margin: 8px 0;
}

QSlider::handle:horizontal {
  image: url(:/icon/theme/dark_orange/primary/slider.svg);
  width: 18px;
  height: 18px;
  margin: -7px -9px;
}

QSlider::handle:vertical {
  image: url(:/icon/theme/dark_orange/primary/slider.svg);
  border-radius: 9px;
  width: 18px;
  height: 18px;
  margin: -9px -7px;
}

QSlider::add-page {
  background: #2E333E;
  border-radius: 2px;
}

QSlider::sub-page {
  background: #FF8A1F;
  border-radius: 2px;
}

/* ------------------------------------------------------------------------ */
/* QLabel & Dividers                                                        */

QLabel {
  border: none;
  background: transparent;
  color: #E8ECF2;
}

QLabel:disabled {
  color: rgba(232, 236, 242, 0.35);
}

QFrame[frameShape="4"] {
  border-width: 1px 0 0 0;
  background: none;
}

QFrame[frameShape="5"] {
  border-width: 0 1px 0 0;
  background: none;
}

QFrame[frameShape="4"],
QFrame[frameShape="5"] {
  border-color: #2A2F3A;
}

/* ------------------------------------------------------------------------ */
/* QToolBar & QToolButton                                                   */

QToolBar {
  background: #22252D;
  border: none;
}

QToolBar:horizontal {
  border-bottom: 1px solid #2A2F3A;
}

QToolBar:vertical {
  border-right: 1px solid #2A2F3A;
}

QToolBar::handle:horizontal {
  image: url(:/icon/theme/dark_orange/primary/toolbar-handle-horizontal.svg);
}

QToolBar::handle:vertical {
  image: url(:/icon/theme/dark_orange/primary/toolbar-handle-vertical.svg);
}

QToolBar::separator:horizontal {
  border-right: 1px solid #2A2F3A;
  width: 1px;
}

QToolBar::separator:vertical {
  border-top: 1px solid #2A2F3A;
  height: 1px;
}

QToolButton {
  background-color: transparent;
  color: #E8ECF2;
  border: none;
  border-radius: 7px;
  height: 28px;
  margin: 1px 2px;
  padding: 2px 10px;
}

QToolButton:hover {
  background-color: #2F3440;
}

QToolButton:pressed {
  background-color: #1D2026;
}

QToolButton:checked {
  background-color: rgba(255, 138, 31, 0.16);
  color: #FF8A1F;
  font-weight: 600;
}

QToolButton:checked:hover {
  background-color: rgba(255, 138, 31, 0.24);
}

/* ------------------------------------------------------------------------ */
/* Tables, Trees & Lists                                                    */

QTableView {
  background-color: #22252D;
  alternate-background-color: #1D2026;
  border: 1px solid #2E333E;
  border-radius: 8px;
  gridline-color: #2A2F3A;
  selection-background-color: rgba(255, 138, 31, 0.16);
  selection-color: #E8ECF2;
}

QTreeView,
QListView {
  border-radius: 8px;
  padding: 4px;
  margin: 0px;
}

QTableView::item,
QTreeView::item,
QListView::item {
  padding: 6px 8px;
  min-height: 26px;
  color: #E8ECF2;
  selection-color: #E8ECF2;
  border-color: transparent;
}

QTableView::item:hover,
QTreeView::item:hover,
QListView::item:hover {
  background-color: #2F3440;
  border-radius: 6px;
}

QTableView::item:selected,
QTreeView::item:selected,
QListView::item:selected {
  background-color: rgba(255, 138, 31, 0.16);
  selection-background-color: rgba(255, 138, 31, 0.16);
  color: #FF8A1F;
  selection-color: #FF8A1F;
  border-radius: 6px;
}

QTableView::item:selected:focus,
QTreeView::item:selected:focus,
QListView::item:selected:focus {
  background-color: rgba(255, 138, 31, 0.24);
  selection-background-color: rgba(255, 138, 31, 0.24);
  color: #FF8A1F;
  selection-color: #FF8A1F;
}

QTableView::item:disabled {
  color: rgba(232, 236, 242, 0.35);
  background-color: #1D2026;
}

/* Specialized list item overrides (must come after generic QListView::item) */
ComicListWidget::item,
ComicListWidget::item:hover,
ComicListWidget::item:selected,
ComicListWidget::item:selected:focus {
  background-color: transparent;
  border: none;
  padding: 0px;
  margin: 0px;
}

UserListWidget::item {
  border-bottom: 1px solid #2A2F3A;
  padding: 6px 4px;
}

UserListWidget::item:hover,
UserListWidget::item:selected,
UserListWidget::item:selected:focus {
  background-color: transparent;
}

NasView QListWidget::item {
  background-color: #22252D;
  border: 1px solid #2E333E;
  border-radius: 8px;
  margin: 4px 2px;
}

NasView QListWidget::item:hover {
  border-color: #3D4452;
  background-color: #2F3440;
}

QTreeView::branch {
  background-color: transparent;
}
QTreeView::branch:closed:has-children:has-siblings,
QTreeView::branch:closed:has-children:!has-siblings {
  image: url(:/icon/theme/dark_orange/primary/branch-closed.svg);
}
QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings {
  image: url(:/icon/theme/dark_orange/primary/branch-open.svg);
}
QTreeView::branch:has-siblings:!adjoins-item {
  border-image: url(:/icon/theme/dark_orange/disabled/vline.svg) 0;
}
QTreeView::branch:has-siblings:adjoins-item {
  border-image: url(:/icon/theme/dark_orange/disabled/branch-more.svg) 0;
}
QTreeView::branch:!has-children:!has-siblings:adjoins-item,
QTreeView::branch:has-children:!has-siblings:adjoins-item {
  border-image: url(:/icon/theme/dark_orange/disabled/branch-end.svg) 0;
}

QTableCornerButton::section {
  background-color: #22252D;
  border: none;
  border-bottom: 1px solid #2A2F3A;
}

QHeaderView {
  border: none;
  background-color: transparent;
}

QHeaderView::section {
  color: #94A3B8;
  font-weight: 600;
  background-color: #22252D;
  padding: 0 14px;
  height: 36px;
  border: none;
  border-bottom: 1px solid #2A2F3A;
}

QTreeView QHeaderView::section {
  border: none;
}

/* ------------------------------------------------------------------------ */
/* Misc Widgets                                                             */

QLCDNumber {
  color: #FF8A1F;
  background-color: rgba(255, 138, 31, 0.16);
  border: 1px solid rgba(255, 138, 31, 0.45);
  border-radius: 6px;
}

#qt_calendar_prevmonth {
  qproperty-icon: url(:/icon/theme/dark_orange/primary/leftarrow.svg);
}

#qt_calendar_nextmonth {
  qproperty-icon: url(:/icon/theme/dark_orange/primary/rightarrow.svg);
}

QTreeView QLineEdit,
QTableView QLineEdit,
QListView QLineEdit {
  color: #E8ECF2;
  background-color: #272B35;
  border: 1px solid #FF8A1F;
  border-radius: 4px;
  padding: 2px 6px;
}
